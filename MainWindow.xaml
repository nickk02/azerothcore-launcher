<Window
    x:Class="AzerothCore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AzerothCore">

    <Grid x:Name="RootGrid" Background="#0A0A0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The title bar is chrome and nothing else: a wordmark, the system
             caption buttons, and drag space. The nav items that used to live
             here are gone along with the destinations they pointed at: login
             and setup are one page now, and Addons is not built yet. With no
             clickable children left, the entire bar goes to SetTitleBar(),
             which is what makes all of it draggable. Put an interactive
             control back in here and the drag region will swallow its clicks;
             carve out a narrower Border for the drag region if that happens. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#141414">
            <TextBlock Text="AZEROTHCORE" Foreground="#CBB98A" FontSize="12"
                       FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1"/>
    </Grid>
</Window>
