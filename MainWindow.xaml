<Window
    x:Class="AzerothCore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AzerothCore">

    <Grid x:Name="RootGrid" Background="#0A0A0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#141414">
            <TextBlock Text="AzerothCore" Foreground="#DCE4F2" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#141414" BorderBrush="#242424" BorderThickness="0,0,1,0">
                <StackPanel Spacing="4" Padding="0,24,0,0" HorizontalAlignment="Stretch">
                    <Border Tapped="NavHome_Tapped" Background="Transparent" Padding="0,14">
                        <TextBlock x:Name="NavHome" Text="HOME" FontSize="12" Foreground="#F0C860"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Tapped="NavAddons_Tapped" Background="Transparent" Padding="0,14">
                        <TextBlock x:Name="NavAddons" Text="ADDONS" FontSize="12" Foreground="#B8DCE4F2"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Tapped="NavCharacters_Tapped" Background="Transparent" Padding="0,14">
                        <TextBlock x:Name="NavCharacters" Text="CHARS" FontSize="12" Foreground="#B8DCE4F2"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Tapped="NavSettings_Tapped" Background="Transparent" Padding="0,14">
                        <TextBlock x:Name="NavSettings" Text="SETTINGS" FontSize="12" Foreground="#B8DCE4F2"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
