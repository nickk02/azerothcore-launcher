<Window
    x:Class="AzerothCore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AzerothCore">

    <Grid x:Name="RootGrid" Background="#0A0A0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navigation lives in the title bar now: the old 76px left rail cost
             horizontal space the hero art wanted and gave nothing back for it.
             Only DragRegion is passed to SetTitleBar(); if the whole bar were the
             drag region it would swallow clicks on the nav items. -->
        <Grid Grid.Row="0" Background="#141414">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DragRegion" Grid.Column="0" Background="Transparent" Padding="14,0,20,0">
                <TextBlock Text="AZEROTHCORE" Foreground="#CBB98A" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Border x:Name="NavHomeItem" Tapped="NavHome_Tapped" Background="Transparent"
                        Padding="16,0" Height="44">
                    <Grid>
                        <TextBlock x:Name="NavHome" Text="HOME" FontSize="12" Foreground="#F0C860"
                                   VerticalAlignment="Center"/>
                        <Rectangle x:Name="NavHomeUnderline" Height="2" Fill="#F0C860" Opacity="1"
                                   VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </Grid>
                </Border>

                <Border x:Name="NavAddonsItem" Tapped="NavAddons_Tapped" Background="Transparent"
                        Padding="16,0" Height="44">
                    <Grid>
                        <TextBlock x:Name="NavAddons" Text="ADDONS" FontSize="12" Foreground="#B8DCE4F2"
                                   VerticalAlignment="Center"/>
                        <Rectangle x:Name="NavAddonsUnderline" Height="2" Fill="#F0C860" Opacity="0"
                                   VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </Grid>
                </Border>

                <Border x:Name="NavSettingsItem" Tapped="NavSettings_Tapped" Background="Transparent"
                        Padding="16,0" Height="44">
                    <Grid>
                        <TextBlock x:Name="NavSettings" Text="SETTINGS" FontSize="12" Foreground="#B8DCE4F2"
                                   VerticalAlignment="Center"/>
                        <Rectangle x:Name="NavSettingsUnderline" Height="2" Fill="#F0C860" Opacity="0"
                                   VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1"/>
    </Grid>
</Window>
