<Window
    x:Class="AzerothCore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AzerothCore">

    <Grid x:Name="RootGrid" Background="#0A0A0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The title bar is chrome and nothing else: the system caption
             buttons and drag space, no wordmark and no nav. The app announces
             itself with the Warcraft logo on the page below; a second name in
             the corner was just a label on a launcher the user already opened
             deliberately. Window.Title is still set, so the taskbar and Alt-Tab
             still say AzerothCore.

             With no children at all, the entire bar goes to SetTitleBar(),
             which is what makes all of it draggable. Put an interactive control
             back in here and the drag region will swallow its clicks; carve out
             a narrower Border for the drag region if that ever happens. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#141414"/>

        <Frame x:Name="ContentFrame" Grid.Row="1"/>
    </Grid>
</Window>
