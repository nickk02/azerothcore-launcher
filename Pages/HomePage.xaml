<Page
    x:Class="AzerothCore.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- A launcher that never moves reads as a screenshot of an application
             rather than an application. The hero drifts continuously, and the
             logo and login box arrive rather than appearing. Both are slow and
             low-amplitude on purpose: this should register as the page being
             alive, not as an effect demanding attention. -->
        <Storyboard x:Key="HeroDrift" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="HeroTransform" Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.09" Duration="0:0:26" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeroTransform" Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.09" Duration="0:0:26" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeroTransform" Storyboard.TargetProperty="TranslateX"
                             From="0" To="26" Duration="0:0:26" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ContentEntrance">
            <DoubleAnimation Storyboard.TargetName="LogoImage" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5" EnableDependentAnimation="True"/>
            <DoubleAnimation Storyboard.TargetName="LogoTransform" Storyboard.TargetProperty="TranslateY"
                             From="-18" To="0" Duration="0:0:0.6" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="LoginPanel" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.5"
                             EnableDependentAnimation="True"/>
            <DoubleAnimation Storyboard.TargetName="LoginTransform" Storyboard.TargetProperty="TranslateY"
                             From="22" To="0" BeginTime="0:0:0.12" Duration="0:0:0.6"
                             EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <!-- RootGrid is clipped to its own bounds in code-behind (WinUI3 panels do
         not clip children, and there is no ClipToBounds). Without that clip the
         hero image, which both overhangs the left edge and scales past its box
         while drifting, would paint over the shell around it. -->
    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <Image x:Name="HeroImage" Source="/Assets/wotlk-hero.png" Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               Margin="-80,0,0,0" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <CompositeTransform x:Name="HeroTransform"/>
            </Image.RenderTransform>
        </Image>

        <!-- Two columns so the logo centres on the art rather than on the whole
             page. Centred across the full width it collided with the login box,
             putting the panel on top of "WARCRAFT". -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="LogoImage" Grid.Column="0" Source="/Assets/wotlk-logo.png" Height="150"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Opacity="0"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="LogoTransform"/>
                </Image.RenderTransform>
            </Image>

            <StackPanel x:Name="LoginPanel" Grid.Column="1" Width="252"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Opacity="0">
                <StackPanel.RenderTransform>
                    <CompositeTransform x:Name="LoginTransform"/>
                </StackPanel.RenderTransform>

                <Border Padding="16" CornerRadius="4"
                        Background="#D90A0A0A" BorderBrush="#CBB98A" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="RealmStatusTextBlock" Text="No realm configured"
                                   Foreground="#CBB98A" FontSize="11" HorizontalAlignment="Center"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="ACCOUNT NAME" Foreground="#CBB98A" FontSize="10" FontWeight="SemiBold"/>
                            <TextBox x:Name="AccountNameBox" Background="#141414" Foreground="#DCE4F2"
                                     BorderBrush="#CBB98A" BorderThickness="1" Padding="8,6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="PASSWORD" Foreground="#CBB98A" FontSize="10" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="PasswordBox" Background="#141414" Foreground="#DCE4F2"
                                         BorderBrush="#CBB98A" BorderThickness="1" Padding="8,6"/>
                        </StackPanel>

                        <CheckBox x:Name="RememberMeCheckBox" Content="Remember me" Foreground="#DCE4F2"/>
                    </StackPanel>
                </Border>

                <!-- State brushes are overridden as resources rather than by
                     setting Background/Foreground directly, because the default
                     template swaps those out on hover and press and would undo a
                     plain property set. -->
                <Button x:Name="PlayButton" Content="Play" Click="PlayButton_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="16" FontWeight="SemiBold">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="#CBB98A"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F0C860"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A89768"/>
                        <SolidColorBrush x:Key="ButtonForeground" Color="#0A0A0A"/>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#0A0A0A"/>
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#0A0A0A"/>
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#F0C860"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#F0C860"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#CBB98A"/>
                    </Button.Resources>
                </Button>

                <TextBlock x:Name="StatusTextBlock" Text="" Foreground="#88DCE4F2"
                           FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
