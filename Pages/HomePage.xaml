<Page
    x:Class="AzerothCore.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- Lightweight styling. Every one of these keys is a brush the default
             control template already looks up by name, so overriding them here
             restyles every TextBox, PasswordBox and CheckBox on the page at
             once. Setting Background/BorderBrush on the controls directly does
             not work: the templates swap those brushes out again on hover,
             press and focus, so a plain property set looks correct until the
             pointer touches it and then snaps back to system chrome. Every
             interactive state is listed explicitly for that reason. A state
             left out is a state that falls back to default light-theme blue. -->

        <!-- TextBox and PasswordBox share the TextControl* keys. -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#B3141414"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#CC1C1C1C"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#F2101010"/>
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#66141414"/>

        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#66CBB98A"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#A6CBB98A"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#F0C860"/>
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#33CBB98A"/>

        <SolidColorBrush x:Key="TextControlForeground" Color="#DCE4F2"/>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#DCE4F2"/>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#77DCE4F2"/>

        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#66DCE4F2"/>
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#88DCE4F2"/>
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#88DCE4F2"/>

        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#CBB98A"/>

        <!-- CheckBox: box stroke, box fill and glyph each have their own
             unchecked/checked x rest/hover/press brush. -->
        <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="#DCE4F2"/>
        <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="#F0C860"/>
        <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPressed" Color="#CBB98A"/>
        <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="#DCE4F2"/>
        <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="#F0C860"/>
        <SolidColorBrush x:Key="CheckBoxForegroundCheckedPressed" Color="#CBB98A"/>

        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#88CBB98A"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#F0C860"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#CBB98A"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#F0C860"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#F0C860"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#CBB98A"/>

        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#66141414"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#33CBB98A"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#55CBB98A"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#CBB98A"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#F0C860"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#A89768"/>

        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#0A0A0A"/>

        <!-- A launcher that never moves reads as a screenshot of an application
             rather than an application. The hero drifts continuously, and the
             logo and panel arrive rather than appearing. Both are slow and
             low-amplitude on purpose: this should register as the page being
             alive, not as an effect demanding attention. -->
        <Storyboard x:Key="HeroDrift" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="HeroTransform" Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.09" Duration="0:0:26" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeroTransform" Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.09" Duration="0:0:26" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeroTransform" Storyboard.TargetProperty="TranslateX"
                             From="0" To="26" Duration="0:0:26" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ContentEntrance">
            <DoubleAnimation Storyboard.TargetName="LogoImage" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5" EnableDependentAnimation="True"/>
            <DoubleAnimation Storyboard.TargetName="LogoTransform" Storyboard.TargetProperty="TranslateY"
                             From="-18" To="0" Duration="0:0:0.6" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- The panel slides in from its own edge rather than from below.
                 It is anchored to the right side of the window, so coming in
                 from the right reads as the panel settling into place. -->
            <DoubleAnimation Storyboard.TargetName="SidePanel" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.5"
                             EnableDependentAnimation="True"/>
            <DoubleAnimation Storyboard.TargetName="PanelTransform" Storyboard.TargetProperty="TranslateX"
                             From="34" To="0" BeginTime="0:0:0.12" Duration="0:0:0.6"
                             EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <!-- RootGrid is clipped to its own bounds in code-behind (WinUI3 panels do
         not clip children, and there is no ClipToBounds). Without that clip the
         hero image, which both overhangs the left edge and scales past its box
         while drifting, would paint over the shell around it. -->
    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <Image x:Name="HeroImage" Source="/Assets/wotlk-hero.png" Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               Margin="-80,0,0,0" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <CompositeTransform x:Name="HeroTransform"/>
            </Image.RenderTransform>
        </Image>

        <!-- The wash spans the whole window rather than sitting inside the
             field column, which is what lets the fade be wider than the fields
             are.

             It is a scrim, not a backdrop: it tops out at 72% black and holds
             there, so the art carries all the way to the right edge and is
             merely dimmed behind the fields rather than replaced by them. At
             the near-opaque value this used to end on, the right third was
             flatly black and the panel read as a separate box bolted onto the
             art instead of as part of the same image. 72% is enough for
             #DCE4F2 text over the darkest part of the hero and still leaves
             the cape and pillars visible through it. -->
        <Rectangle x:Name="ArtWash">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.00" Color="#00000000"/>
                    <GradientStop Offset="0.32" Color="#00000000"/>
                    <GradientStop Offset="0.52" Color="#8A000000"/>
                    <GradientStop Offset="0.68" Color="#B8000000"/>
                    <GradientStop Offset="1.00" Color="#B8000000"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- The logo centres on the page, not on a column. Earlier revisions
             centred it on the art left of the wash, which only made sense while
             the wash ended opaque and genuinely cut the art off there. Now that
             the wash only dims, the whole width is still one image, so the page
             centre is the real centre. At 280px wide it ends around x=690 and
             still clears the fields, which begin at 728. -->
        <Image x:Name="LogoImage" Source="/Assets/wotlk-logo.png" Height="140"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" Opacity="0"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <CompositeTransform x:Name="LogoTransform"/>
            </Image.RenderTransform>
        </Image>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="372"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidePanel" Grid.Column="1" Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="PanelTransform"/>
                </Border.RenderTransform>

                <Grid Margin="34,0,26,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="14">

                        <TextBlock x:Name="RealmStatusTextBlock" Text="No realm configured"
                                   Foreground="#CBB98A" FontSize="13" FontWeight="SemiBold"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="ACCOUNT NAME" Foreground="#CBB98A" FontSize="12" FontWeight="SemiBold"/>
                            <TextBox x:Name="AccountNameBox" Padding="8,6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="PASSWORD" Foreground="#CBB98A" FontSize="12" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="PasswordBox" Padding="8,6"/>
                        </StackPanel>

                        <CheckBox x:Name="RememberMeCheckBox" Content="Remember me"
                                  Checked="RememberMeCheckBox_Changed" Unchecked="RememberMeCheckBox_Changed"/>

                        <Button x:Name="PlayButton" Content="Play" Click="PlayButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,12" FontSize="18" FontWeight="SemiBold" CornerRadius="3">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="#CBB98A"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F0C860"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A89768"/>
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#44CBB98A"/>
                                <SolidColorBrush x:Key="ButtonForeground" Color="#0A0A0A"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#0A0A0A"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#0A0A0A"/>
                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#880A0A0A"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="#F0C860"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFE9A6"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#CBB98A"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#44F0C860"/>
                            </Button.Resources>
                        </Button>

                        <TextBlock x:Name="StatusTextBlock" Text="" Foreground="#FF9B9B"
                                   FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>

                        <!-- Setup lives on this page rather than behind a tab.
                             There are four fields in the whole application; a
                             separate destination for two of them was more
                             navigation than the app has content.

                             No section heading: the labels already say what
                             each field is, and "SETUP" over two self-describing
                             rows was a caption for something that needed no
                             caption. Extra top margin carries the grouping
                             instead, since these are configured once and then
                             ignored, unlike the login fields above. -->
                        <StackPanel Spacing="10" Margin="0,14,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="WOW INSTALL PATH" Foreground="#CBB98A" FontSize="12" FontWeight="SemiBold"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WowPathBox" Grid.Column="0" IsReadOnly="True"
                                             Padding="8,6" FontSize="14"
                                             PlaceholderText="Not set"/>
                                    <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse"
                                            Click="BrowseButton_Click" Padding="12,6" CornerRadius="3">
                                        <!-- Ghost variant of the Play button:
                                             same palette, outline instead of
                                             fill, so it reads as secondary but
                                             still has real hover and press
                                             states of its own. -->
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="#00000000"/>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33CBB98A"/>
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#59CBB98A"/>
                                            <SolidColorBrush x:Key="ButtonForeground" Color="#CBB98A"/>
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F0C860"/>
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F0C860"/>
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#66CBB98A"/>
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#F0C860"/>
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#CBB98A"/>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="REALM ADDRESS" Foreground="#CBB98A" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox x:Name="RealmAddressBox" Padding="8,6" FontSize="14"
                                         PlaceholderText="e.g. 10.0.0.85"
                                         TextChanged="RealmAddressBox_TextChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom right of the panel. Left-aligned it floated in
                         the middle of the window with nothing under it, which
                         read as a stray line rather than as a version stamp.
                         Right and Bottom are both explicit: the row is Auto
                         height, so without VerticalAlignment the text sits
                         wherever the row lands rather than on the floor. -->
                    <TextBlock x:Name="VersionTextBlock" Grid.Row="1" Text=""
                               Foreground="#66DCE4F2" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,0,16"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
