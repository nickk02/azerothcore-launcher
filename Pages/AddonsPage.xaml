<Page
    x:Class="AzerothCore.Pages.AddonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- Same lightweight styling approach as HomePage: the control
             templates look these brushes up by name, so setting them here
             restyles the search field. Setting Background on the control
             directly does not survive hover or focus. -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#B3141414"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#CC1C1C1C"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#F2101010"/>
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#66CBB98A"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#A6CBB98A"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#F0C860"/>
        <SolidColorBrush x:Key="TextControlForeground" Color="#DCE4F2"/>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#DCE4F2"/>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#66DCE4F2"/>
    </Page.Resources>

    <Grid Background="#0A0A0A" Width="620" Height="470">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The brief called for this explicitly: say what the list is. A bare
             grid of names does not tell anyone where the results come from or
             where an install lands. -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock Text="ADDONS" Foreground="#CBB98A" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Foreground="#A6DCE4F2" FontSize="12" TextWrapping="Wrap">
                Results come from Felbite. Install puts the addon into your client's
                Interface\AddOns folder. Restart the game to load anything new.
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0" Padding="8,6" FontSize="13"
                     PlaceholderText="Search addons" KeyDown="SearchBox_KeyDown"/>

            <Button x:Name="SearchButton" Grid.Column="1" Content="Search"
                    Click="SearchButton_Click" Padding="14,6" CornerRadius="3">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#CBB98A"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F0C860"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A89768"/>
                    <SolidColorBrush x:Key="ButtonForeground" Color="#0A0A0A"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#0A0A0A"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#0A0A0A"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#F0C860"/>
                </Button.Resources>
            </Button>

            <HyperlinkButton x:Name="OpenFolderLink" Grid.Column="2" Content="Open folder"
                             Click="OpenFolderLink_Click" Padding="6,0" FontSize="12"/>
        </Grid>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="" Foreground="#FF9B9B"
                   FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <!-- Rows are built in code-behind rather than by a DataTemplate:
                 each one needs its own Install button and status text wired to
                 one RemoteAddon, and the results are a plain std::vector rather
                 than an observable WinRT collection. -->
            <ItemsControl x:Name="ResultsList"/>
        </ScrollViewer>
    </Grid>
</Page>
