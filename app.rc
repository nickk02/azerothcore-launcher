// The icon is guarded rather than the whole .rc being skipped, because this
// file now also carries VERSIONINFO and that has to exist in every build.
// Assets\wotlk-icon.ico is Blizzard art and is never committed, so any clone
// or CI checkout builds without it; azerothcore.vcxproj defines AC_HAVE_ICON
// only when the file is actually present.
#ifdef AC_HAVE_ICON
IDI_ICON1 ICON "Assets\\wotlk-icon.ico"
#endif

#include <winver.h>

// Supplied by the build: msbuild /p:AcVersion=2026.08.06 turns into these two.
// The defaults are what a plain local build gets, and they are deliberately
// obvious. A launcher reporting 0.0.0-dev is telling the truth about being an
// untagged build rather than quietly claiming to be a release.
#ifndef AC_VERSION_CSV
#define AC_VERSION_CSV 0,0,0,0
#endif
#ifndef AC_VERSION_STR
#define AC_VERSION_STR "0.0.0-dev"
#endif

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    AC_VERSION_CSV
  PRODUCTVERSION AC_VERSION_CSV
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0x0L
  FILEOS         VOS__WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"          // US English, Unicode
    BEGIN
      VALUE "CompanyName",      "AzerothCore"
      VALUE "FileDescription",  "AzerothCore Launcher"
      VALUE "FileVersion",      AC_VERSION_STR
      VALUE "InternalName",     "azerothcore"
      VALUE "OriginalFilename", "azerothcore.exe"
      VALUE "ProductName",      "AzerothCore Launcher"
      VALUE "ProductVersion",   AC_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
